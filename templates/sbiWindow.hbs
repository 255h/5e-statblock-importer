<form class="standard-form">
    <section id="sbi-top">
        <div class="form-group">
            <label for="sbi-import-autoparse">Auto parse:</label>
            <div class="form-fields">
                <input id="sbi-import-autoparse" type="checkbox" checked="checked" />
                <button id="sbi-import-parse" type="button" data-action="parse">Parse</button>
            </div>
            <button id="sbi-import-reset" type="button" data-action="reset">Reset</button>
        </div>
    </section>
    <div class="form-group">
        <label for="sbi-json-file">Load JSON file:</label>
        <div class="form-fields">
            <input id="sbi-json-file" type="file" accept=".json,application/json" />
        </div>
        <button type="button" data-action="compendiumOptions">Compendium Options</button>
    </div>
    <label for="sbi-input">JSON statblock</label>
    <textarea id="sbi-input" spellcheck="false" aria-label="JSON statblock" placeholder='Paste a JSON statblock here, or load a .json file above.
Example: {"name":"Goblin","health":{"value":7,"formula":"2d6"},"abilities":{"str":8,"dex":14,"con":10,"int":10,"wis":8,"cha":8},"challenge":{"cr":"1/4"}}
See README.md for the complete format. Parse validates the data and shows a preview; Import creates the NPC.'></textarea>
    <details id="sbi-preview-container">
        <summary>Parsed data preview</summary>
        <pre id="sbi-preview"></pre>
    </details>
    <section id="sbi-issues"></section>
    <section id="sbi-bottom">
        <span id="sbi-import-text">Folder to import to:</span>
        <select id="sbi-import-select"></select>
        <button id="sbi-import-button" type="button" data-action="import">Import</button>
    </section>
</form>
